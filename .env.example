# Starts in dry-run: breaches are logged/alerted, no orders sent.
# Only false / 0 / no / off turns live trading on; anything else (even empty) keeps dry-run.
DRY_RUN=true

# Seconds after the top of the hour before checking (1–300)
CLOSE_DELAY_SEC=5

# Emergency "hard" level poll interval in seconds (10–3600, or 0 = off).
# Independently, positions are followed and failed closes retried every 30 s.
HARD_CHECK_SEC=30

# Optional Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: standing rules that are never tied to a position or removed after it closes
# KEEP_RULES_AFTER_CLOSE=true

# Optional: file locations
# ACCOUNTS_FILE=accounts.json
# STOPS_FILE=sl.json

# DEBUG=1
